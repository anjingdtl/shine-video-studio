models/
checkpoints/
assets/private/
renders/
outputs/
artifacts/

# Windows and editors
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
# Machine specific shortcuts (absolute paths to this checkout). They must stay
# untracked, or the working tree is never clean and the release build refuses.
*.lnk

# Local agent workspace notes (never shipped in a package)
.workbuddy/
# Local agent scratch space (plans/, tmp/). It changes on every session, so it
# must never enter history: an untracked-but-not-ignored directory keeps the
# working tree permanently dirty and hides real changes during review.
.zcode/

# Personal material dropped by external agent tools; never enter the repo
.codex-attachments/
# Files the person attaches to a conversation are inputs, not project sources.
/.uploads/

# Rust build outputs for the native launcher
/launcher/target/
/work/
