!.env.sample
*.key
*.pem
secrets/
credentials/
# Generated by the one-click installer next to the install root
operator-credentials.txt
install-log-*.txt
releases/
config/local.*
!config/local.example.*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/node_modules/
frontend/node_modules.before-storage-*/
frontend/dist/
frontend/.vite/
.npm/
.pnpm-store/

# Local data, databases and temporary files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
logs/
tmp/
temp/
.cache/
/.local-data/
/.local-acceptance/
/.local-data-*/
# Browser-verification screenshots from agent runs belong in docs/evidence
/gui-test-screenshots/
*.tsbuildinfo

# Model weights and generated media
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.flac
*.mp3
