{
  "name": "local-h3-ref2va-2img",
  "mode": "Ref2VA",
  "checkpoint_id": "Minimax-H3\\minimax_h3_ref2va_pruned_int8_convrot.safetensors",
  "description": "Real local MiniMax-H3 Ref2VA pipeline (int8 diffusion + nvfp4 Qwen3-VL CLIP + fp16 video VAE + fp32 audio VAE), vanilla euler/simple 20-step sampling as proven by the machine's 2026-10-17 reconnect-fixed workflow. Supports exactly one subject image + one picture image; duration in seconds is snapped to the H3 17k+5 frame grid at 24 fps by the ComfyMathExpression node.",
  "required_nodes": [
    "MiniMaxH3ReferenceToVideo",
    "MiniMaxH3SigmaShift",
    "MiniMaxChunkFeedForward",
    "MiniMaxH3MemoryEfficientSageAttentionPatch",
    "MiniMaxLowVRAMAttention",
    "VAEDecodeAudio",
    "SaveVideo"
  ],
  "media_transfers": {
    "image": {
      "upload_path": "/upload/image",
      "field_name": "image",
      "subfolder": "shine",
      "style": "multipart"
    }
  },
  "parameter_map": {
    "positive_prompt": "31.inputs.prompt",
    "duration": "30.inputs.values.a",
    "seed": "51.inputs.noise_seed",
    "reference_subject_1": "40.inputs.image",
    "reference_picture_1": "41.inputs.image",
    "width": "31.inputs.width",
    "height": "31.inputs.height"
  },
  "graph": {
    "10": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "Minimax-H3\\minimax_h3_ref2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "11": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": { "model": ["10", 0], "shift_video": 12.0, "shift_audio": 3.0 }
    },
    "12": {
      "class_type": "MiniMaxChunkFeedForward",
      "inputs": { "model": ["11", 0], "chunks": 2, "seq_threshold": 4096 }
    },
    "13": {
      "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch",
      "inputs": { "model": ["12", 0] }
    },
    "14": {
      "class_type": "MiniMaxLowVRAMAttention",
      "inputs": { "model": ["13", 0], "head_chunks": 4 }
    },
    "20": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "21": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "MiniMax-H3(1)\\minimax_h3_video_vae_fp16.safetensors" }
    },
    "22": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "MiniMax-H3(1)\\minimax_h3_audio_vae_fp32.safetensors" }
    },
    "30": {
      "class_type": "ComfyMathExpression",
      "inputs": {
        "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
        "values.a": 5.17
      }
    },
    "40": { "class_type": "LoadImage", "inputs": { "image": "example.png" } },
    "41": { "class_type": "LoadImage", "inputs": { "image": "example.png" } },
    "31": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": ["20", 0],
        "vae": ["21", 0],
        "audio_vae": ["22", 0],
        "prompt": "",
        "width": 480,
        "height": 864,
        "length": ["30", 1],
        "ref_image_size": "match",
        "ref_images.ref_image_0": ["40", 0],
        "ref_images.ref_image_1": ["41", 0]
      }
    },
    "50": {
      "class_type": "BasicGuider",
      "inputs": { "model": ["14", 0], "conditioning": ["31", 0] }
    },
    "51": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
    "52": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
    "53": {
      "class_type": "BasicScheduler",
      "inputs": { "model": ["14", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 }
    },
    "54": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["51", 0],
        "guider": ["50", 0],
        "sampler": ["52", 0],
        "sigmas": ["53", 0],
        "latent_image": ["31", 1]
      }
    },
    "55": { "class_type": "VAEDecode", "inputs": { "samples": ["54", 0], "vae": ["21", 0] } },
    "56": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["54", 0], "vae": ["22", 0] } },
    "57": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["55", 0],
        "fps": 24.0,
        "audio": ["56", 0],
        "bit_depth": "auto",
        "color_space": "sRGB",
        "codec": "h264"
      }
    },
    "58": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["57", 0],
        "filename_prefix": "shine/ref2va",
        "format": "mp4",
        "codec": { "codec": "h264" }
      }
    }
  }
}
