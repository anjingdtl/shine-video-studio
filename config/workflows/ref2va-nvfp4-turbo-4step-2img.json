{
  "name": "local-h3-ref2va-nvfp4-turbo-4step-2img",
  "mode": "Ref2VA",
  "checkpoint_id": "Minimax-H3-Quants\\MiniMax-H3_Ref2VA-NVFP4.safetensors",
  "description": "PDD-free low-end candidate pipeline for 12GB-class cards, built on the third-party block-scaled NVFP4 Ref2VA DiT (DmitryDB/MiniMax-H3-ComfyUI-Quants) with the official NVFP4 text encoder, the official INT8 ConvRot video VAE, the official FP32 audio VAE and the official 4-step turbo LoRA. Because the turbo LoRA is loaded, the sampler runs 4 steps. The publisher states that no custom node or ComfyUI core patch is required and that ComfyUI needs --lowvram; the publisher also states that its own hardware table covers 8-12 GB only on RTX 50/Blackwell and that no full generation run was performed on an RTX 5090. This profile therefore belongs to the CANDIDATE variant ref2va-nvfp4-lowend: it is not in the default ready set, it is never downloaded automatically, and it has not run on any machine in this project.",
  "required_nodes": [
    "MiniMaxH3ReferenceToVideo",
    "MiniMaxH3SigmaShift",
    "MiniMaxChunkFeedForward",
    "MiniMaxH3MemoryEfficientSageAttentionPatch",
    "MiniMaxLowVRAMAttention",
    "LoraLoaderModelOnly",
    "VAEDecodeAudio",
    "SaveVideo"
  ],
  "media_transfers": {
