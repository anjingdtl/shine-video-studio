# Copy this file to .env for local overrides. Never put credentials here.
SHINE_DATA_DIR=.local-data
# Optional. When unset, the database is .local-data/shine.db.
# SHINE_DATABASE_URL=sqlite:///./.local-data/shine.db

# Mock is the safe development default. Set comfyui only after local H3 acceptance.
SHINE_RENDER_PROVIDER=mock
SHINE_COMFYUI_URL=http://127.0.0.1:8188

# Uploads are configurable for larger video reference material.
# SHINE_MAX_UPLOAD_BYTES=26214400

# Worker lease and heartbeat thresholds.
# SHINE_WORKER_LEASE_SECONDS=30
# SHINE_WORKER_HEARTBEAT_SECONDS=10
# SHINE_WORKER_OFFLINE_SECONDS=30

# Optional. Absolute path to the managed renderer recipe. When it is set and
# the render provider is comfyui, the Worker starts the owned renderer itself
# behind a durable intent instead of contacting an unowned ComfyUI. The
# recipe names the executable, the pinned adapter bytes and the physical
# thresholds only; it never carries a credential. See
# config/managed_recipe.json.example. SHINE_COMFYUI_URL must match the
# recipe's renderer port.
# SHINE_MANAGED_RECIPE=F:\\ClaudeWorkSpace\\projects\\shine-video-studio\\config\\managed_recipe.local.json

# Optional local media tools. Technical QC reports unavailable, never passed,
# when these executables are missing.
# SHINE_FFPROBE=ffprobe
# SHINE_FFMPEG=ffmpeg
