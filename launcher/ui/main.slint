import { AboutSlint } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Shine 视频工作台";
    width: 1080px;
    height: 760px;
    background: #eef2f7;

    in-out property <int> active-tab: 0;
    in-out property <string> app-version: "1.0.0";
    in-out property <string> status-message: "正在启动独立的本机检查…";
    in-out property <bool> is-busy: false;
    in-out property <bool> is-checking: false;

    // 总览
    in-out property <string> installation-name: "尚未选择安装目录";
    in-out property <string> stack-state: "工作台当前没有运行。";
    in-out property <string> web-url: "";
    in-out property <string> readiness: "尚未检查";

    // 环境检测
    in-out property <string> environment-text: "正在读取本机信息…";
    in-out property <string> gpu-text: "";

    // 安装目录
    in-out property <string> directory-text: "可以选择新目录开始安装，也可以选择原有目录进行识别与升级。";
    in-out property <bool> can-register: false;

    // 版本更新
    in-out property <string> version-text: "尚未扫描版本。";
    in-out property <string> update-text: "尚未检查更新。";

    // AI 能力
    in-out property <string> capability-text: "尚未读取能力清单。";

    // 诊断
    in-out property <string> diagnostic-text: "暂无诊断信息。";

    in-out property <bool> show-about: false;

    callback refresh-requested();
    callback start-requested();
    callback stop-requested();
    callback install-requested();
    callback choose-directory-requested();
    callback register-requested();
    callback scan-versions-requested();
    callback check-update-requested();
    callback deploy-capability-requested();
    callback refresh-diagnostics-requested();
    callback about-requested();
    callback close-about-requested();

    // ---------------------------------------------------------------- 顶栏
    Rectangle {
        height: 92px;
        background: #14213d;

        HorizontalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 18px;

            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "Shine 视频工作台";
                    color: #f8fafc;
                    font-size: 27px;
                    font-weight: 700;
                }
                Text {
                    text: "独立启动器 · 无需安装 Python、Node 或 ComfyUI";
                    color: #a8b6cf;
                    font-size: 13px;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle {
                width: 104px;
                height: 34px;
                border-radius: 17px;
                background: #1d4ed8;
                Text {
                    text: "版本 " + root.app-version;
                    color: #dbeafe;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 78px;
                height: 34px;
                border-radius: 17px;
                background: #334155;
                Text {
                    text: "关于";
                    color: #f1f5f9;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.about-requested(); } }
            }
        }
    }

    // ------------------------------------------------------------ 导航条
    Rectangle {
        height: 52px;
        background: #ffffff;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 0 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "启动工作台"; color: root.active-tab == 0 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 0; } }
            }
            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 1 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "环境检测"; color: root.active-tab == 1 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 1; } }
            }
            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 2 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "安装目录"; color: root.active-tab == 2 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 2; } }
            }
            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 3 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "版本与依赖"; color: root.active-tab == 3 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 3; } }
            }
            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 4 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "AI 能力部署"; color: root.active-tab == 4 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 4; } }
            }
            Rectangle {
                width: 150px; height: 36px; border-radius: 8px;
                background: root.active-tab == 5 ? #1d4ed8 : #e2e8f0;
                Text {
                    text: "运行与诊断"; color: root.active-tab == 5 ? #ffffff : #334155;
                    font-size: 14px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 5; } }
            }
        }
    }

    // ------------------------------------------------------------- 内容区
    Rectangle {
        vertical-stretch: 1;
        background: transparent;

        // ============ 1. 启动工作台 ============
        if root.active-tab == 0: VerticalLayout {
            padding: 22px;
            spacing: 16px;

            Rectangle {
                height: 132px; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 22px; spacing: 10px;
                    Text {
                        text: "准备好后，一键打开工作台";
                        color: #0f172a; font-size: 22px; font-weight: 700;
                    }
                    Text {
                        text: root.stack-state; color: #475569; font-size: 15px; wrap: word-wrap;
                    }
                    Text {
                        text: root.web-url; color: #1d4ed8; font-size: 14px; wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 96px; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 18px; spacing: 6px;
                    Text {
                        text: "当前安装：" + root.installation-name;
                        color: #0f172a; font-size: 15px; font-weight: 700; wrap: word-wrap;
                    }
                    Text {
                        text: "准备状态：" + root.readiness;
                        color: #475569; font-size: 13px; wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    width: 200px; height: 52px; border-radius: 12px;
                    background: root.is-busy ? #93c5fd : #1d4ed8;
                    Text {
                        text: root.is-busy ? "正在处理…" : "启动工作台";
                        color: #ffffff; font-size: 16px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.start-requested(); }
                    }
                }

                Rectangle {
                    width: 180px; height: 52px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #334155;
                    Text {
                        text: "停止工作台"; color: #ffffff; font-size: 16px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.stop-requested(); }
                    }
                }

                Rectangle {
                    width: 210px; height: 52px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #0f766e;
                    Text {
                        text: "一键安装与修复"; color: #ffffff; font-size: 16px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.install-requested(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        // ============ 2. 环境检测 ============
        if root.active-tab == 1: VerticalLayout {
            padding: 22px; spacing: 14px;

            Rectangle {
                height: 60px; border-radius: 14px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px; spacing: 14px;
                    Text {
                        text: "已安装、已验证、兼容、待修复与尚未真实验证会分别标注。";
                        color: #475569; font-size: 14px; vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 130px; height: 36px; border-radius: 9px;
                        background: root.is-checking ? #cbd5e1 : #334155;
                        Text {
                            text: root.is-checking ? "正在检查…" : "重新检测";
                            color: #ffffff; font-size: 14px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: !root.is-checking;
                            clicked => { root.refresh-requested(); }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text {
                        text: root.environment-text; color: #0f172a; font-size: 14px;
                        wrap: word-wrap; vertical-stretch: 1;
                    }
                }
            }

            Rectangle {
                height: 76px; border-radius: 14px; background: #eff6ff;
                border-width: 1px; border-color: #bfdbfe;
                VerticalLayout {
                    padding: 16px; spacing: 4px;
                    Text {
                        text: "AI 运行条件"; color: #1e3a8a; font-size: 14px; font-weight: 700;
                    }
                    Text {
                        text: root.gpu-text; color: #1e40af; font-size: 13px; wrap: word-wrap;
                    }
                }
            }
        }

        // ============ 3. 安装目录 ============
        if root.active-tab == 2: VerticalLayout {
            padding: 22px; spacing: 14px;

            Rectangle {
                height: 74px; border-radius: 14px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 16px; spacing: 5px;
                    Text {
                        text: "首次使用请选择安装目录；已有旧版请直接选择原目录，"
                            + "启动器会识别原有项目、数据库、模型与素材，并保留历史作品。";
                        color: #475569; font-size: 13px; wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text {
                        text: root.directory-text; color: #0f172a; font-size: 14px;
                        wrap: word-wrap; vertical-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 200px; height: 50px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #1d4ed8;
                    Text {
                        text: "选择目录并识别"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.choose-directory-requested(); }
                    }
                }
                Rectangle {
                    width: 190px; height: 50px; border-radius: 12px;
                    background: root.can-register ? #0f766e : #cbd5e1;
                    Text {
                        text: "登记并保留历史"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: root.can-register && !root.is-busy;
                        clicked => { root.register-requested(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        // ============ 4. 版本与依赖 ============
        if root.active-tab == 3: VerticalLayout {
            padding: 22px; spacing: 14px;

            Rectangle {
                height: 116px; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 18px; spacing: 7px;
                    Text {
                        text: "版本信息"; color: #0f172a; font-size: 16px; font-weight: 700;
                    }
                    Text {
                        text: root.version-text; color: #475569; font-size: 13px; wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
            }

            Rectangle {
                height: 116px; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 18px; spacing: 7px;
                    Text {
                        text: "更新"; color: #0f172a; font-size: 16px; font-weight: 700;
                    }
                    Text {
                        text: root.update-text; color: #475569; font-size: 13px; wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 170px; height: 50px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #334155;
                    Text {
                        text: "扫描可用版本"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.scan-versions-requested(); }
                    }
                }
                Rectangle {
                    width: 190px; height: 50px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #0f766e;
                    Text {
                        text: "检查启动器更新"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.check-update-requested(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        // ============ 5. AI 能力部署 ============
        if root.active-tab == 4: VerticalLayout {
            padding: 22px; spacing: 14px;

            Rectangle {
                height: 74px; border-radius: 14px; background: #fffbeb;
                border-width: 1px; border-color: #fde68a;
                VerticalLayout {
                    padding: 16px; spacing: 5px;
                    Text {
                        text: "只安装项目已正式支持的能力。未通过真实生成验证的能力会明确标注为待验证，"
                            + "不会显示为已就绪。";
                        color: #92400e; font-size: 13px; wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text {
                        text: root.capability-text; color: #0f172a; font-size: 14px;
                        wrap: word-wrap; vertical-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 210px; height: 50px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #1d4ed8;
                    Text {
                        text: "检查并部署能力"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.deploy-capability-requested(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        // ============ 6. 运行与诊断 ============
        if root.active-tab == 5: VerticalLayout {
            padding: 22px; spacing: 14px;

            Rectangle {
                height: 74px; border-radius: 14px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 16px; spacing: 5px;
                    Text {
                        text: "这里显示受管服务的端口、进程身份与安装日志。高级信息默认折叠。";
                        color: #475569; font-size: 13px; wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1; border-radius: 16px; background: #ffffff;
                border-width: 1px; border-color: #dbe3ee;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text {
                        text: root.diagnostic-text; color: #0f172a; font-size: 13px;
                        wrap: word-wrap; vertical-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 190px; height: 50px; border-radius: 12px;
                    background: root.is-busy ? #cbd5e1 : #334155;
                    Text {
                        text: "刷新诊断信息"; color: #ffffff; font-size: 15px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: !root.is-busy;
                        clicked => { root.refresh-diagnostics-requested(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }
    }

    // ------------------------------------------------------------- 状态栏
    Rectangle {
        height: 40px;
        background: #ffffff;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            Text {
                text: root.status-message; color: #64748b; font-size: 12px;
                vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
            }
            Text {
                text: "Shine Launcher · v" + root.app-version;
                color: #94a3b8; font-size: 12px; vertical-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------- 关于
    if root.show-about: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: #0f172a99;
        TouchArea { clicked => { } }

        Rectangle {
            x: (parent.width - 540px) / 2;
            y: (parent.height - 330px) / 2;
            width: 540px; height: 330px;
            border-radius: 18px; background: #ffffff;
            VerticalLayout {
                padding: 26px; spacing: 14px;
                Text {
                    text: "关于 Shine 启动器"; color: #0f172a; font-size: 21px; font-weight: 700;
                }
                Text {
                    text: "版本 " + root.app-version + " · 独立的 Windows 桌面启动与管理中心";
                    color: #475569; font-size: 14px; wrap: word-wrap;
                }
                Text {
                    text: "启动器不依赖工作台的 Python、Node、ComfyUI 或网络即可打开，"
                        + "并会在工作台无法启动时提供诊断与修复入口。";
                    color: #475569; font-size: 13px; wrap: word-wrap;
                }
                AboutSlint { }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    width: 110px; height: 40px; border-radius: 10px; background: #1d4ed8;
                    Text {
                        text: "关闭"; color: #ffffff; font-size: 14px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-about-requested(); } }
                }
            }
        }
    }
}
