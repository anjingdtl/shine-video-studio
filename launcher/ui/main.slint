import { AboutSlint } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Shine Launcher";
    width: 1000px;
    height: 680px;
    background: #f1f4f8;

    in-out property <string> app_version: "0.1.0";
    in-out property <string> os_summary: "正在读取…";
    in-out property <string> cpu_summary: "正在读取…";
    in-out property <string> memory_summary: "正在读取…";
    in-out property <string> disk_summary: "正在读取…";
    in-out property <string> node_summary: "正在检查…";
    in-out property <string> npm_summary: "正在检查…";
    in-out property <string> python_summary: "正在检查…";
    in-out property <string> uv_summary: "正在检查…";
    in-out property <string> ffmpeg_summary: "正在检查…";
    in-out property <string> gpu_summary: "正在检查…";
    in-out property <string> registry_summary: "正在读取注册记录…";
    in-out property <string> release_summary: "尚未扫描 GitHub 版本；扫描只读取发布元数据。";
    in-out property <string> legacy_scan_summary: "可选择旧版目录进行只读识别。扫描不会启动程序或修改目录。";
    in-out property <string> status_message: "正在启动独立环境检查…";
    in-out property <bool> is_checking: false;
    in-out property <bool> is_scanning_legacy: false;
    in-out property <bool> is_scanning_versions: false;
    in-out property <bool> can_register_installation: false;
    in-out property <bool> show_about: false;

    callback refresh_requested();
    callback about_requested();
    callback close_about_requested();
    callback choose_legacy_requested();
    callback register_legacy_requested();
    callback scan_versions_requested();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Rectangle {
            height: 84px;
            border-radius: 18px;
            background: #111827;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;

                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Text {
                        text: "Shine 视频工作台";
                        font-size: 25px;
                        font-weight: 700;
                        color: #f9fafb;
                    }
                    Text {
                        text: "原生启动与管理中心 · 离线可打开";
                        font-size: 14px;
                        color: #cbd5e1;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Rectangle {
                    width: 132px;
                    height: 34px;
                    border-radius: 17px;
                    background: #164e63;
                    Text {
                        text: "工程预览版";
                        color: #cffafe;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 78px;
                    height: 34px;
                    border-radius: 17px;
                    background: #334155;
                    Text {
                        text: "关于";
                        color: #f8fafc;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.about_requested(); } }
                }
            }
        }

        Rectangle {
            height: 66px;
            border-radius: 14px;
            background: #e0f2fe;
            border-width: 1px;
            border-color: #bae6fd;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 14px;
                Text { text: "●"; color: #0284c7; font-size: 24px; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: "独立运行状态";
                        color: #0c4a6e;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: "启动器不依赖 Studio 的 Python、Node、API、Worker 或 GPU 服务";
                        color: #075985;
                        font-size: 13px;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: "离线核心：可用";
                    color: #0369a1;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                height: 176px;
                border-radius: 16px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "本机系统"; color: #64748b; font-size: 13px; }
                    Text { text: root.os_summary; color: #0f172a; font-size: 19px; font-weight: 700; wrap: word-wrap; }
                    Text { text: root.cpu_summary; color: #334155; font-size: 14px; }
                    Text { text: root.memory_summary; color: #334155; font-size: 14px; }
                    Text { text: root.disk_summary; color: #334155; font-size: 14px; }
                }
            }

            Rectangle {
                height: 176px;
                border-radius: 16px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "运行环境（只读）"; color: #64748b; font-size: 13px; }
                    HorizontalLayout { spacing: 10px; Text { text: "Node.js"; color: #334155; font-size: 14px; width: 82px; } Text { text: root.node_summary; color: #0f172a; font-size: 14px; wrap: word-wrap; } }
                    HorizontalLayout { spacing: 10px; Text { text: "npm"; color: #334155; font-size: 14px; width: 82px; } Text { text: root.npm_summary; color: #0f172a; font-size: 14px; wrap: word-wrap; } }
                    HorizontalLayout { spacing: 10px; Text { text: "Python"; color: #334155; font-size: 14px; width: 82px; } Text { text: root.python_summary; color: #0f172a; font-size: 14px; wrap: word-wrap; } }
                    HorizontalLayout { spacing: 10px; Text { text: "uv"; color: #334155; font-size: 14px; width: 82px; } Text { text: root.uv_summary; color: #0f172a; font-size: 14px; wrap: word-wrap; } }
                    HorizontalLayout { spacing: 10px; Text { text: "FFmpeg"; color: #334155; font-size: 14px; width: 82px; } Text { text: root.ffmpeg_summary; color: #0f172a; font-size: 14px; wrap: word-wrap; } }
                }
            }

            Rectangle {
                height: 176px;
                border-radius: 16px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "AI 运行能力"; color: #64748b; font-size: 13px; }
                    Text { text: root.gpu_summary; color: #0f172a; font-size: 15px; wrap: word-wrap; }
                    Text { text: "模型能力未进行真实推理验证"; color: #b45309; font-size: 13px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "GPU 缺失不会阻止启动器打开"; color: #475569; font-size: 12px; wrap: word-wrap; }
                }
            }
        }

        Rectangle {
            height: 120px;
            border-radius: 16px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "旧版目录识别"; color: #0f172a; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 148px;
                        height: 38px;
                        border-radius: 9px;
                        background: root.is_scanning_legacy ? #94a3b8 : #334155;
                        Text { text: root.is_scanning_legacy ? "正在识别…" : "选择目录并扫描"; color: #ffffff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { enabled: !root.is_scanning_legacy; clicked => { root.choose_legacy_requested(); } }
                    }
                    Rectangle {
                        width: 138px;
                        height: 38px;
                        border-radius: 9px;
                        background: root.can_register_installation ? #0f766e : #94a3b8;
                        Text { text: "登记识别结果"; color: #ffffff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { enabled: root.can_register_installation; clicked => { root.register_legacy_requested(); } }
                    }
                }
                Text {
                    text: root.legacy_scan_summary;
                    color: #475569;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }

        Rectangle {
            height: 86px;
            border-radius: 14px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: root.registry_summary; color: #0f172a; font-size: 14px; font-weight: 700; }
                    Text {
                        text: "登记只保存路径；未验证运行能力不会标为 READY。";
                        color: #64748b;
                        font-size: 11px;
                    }
                    Text {
                        text: root.release_summary;
                        color: #64748b;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    width: 126px;
                    height: 38px;
                    border-radius: 10px;
                    background: root.is_scanning_versions ? #94a3b8 : #334155;
                    TouchArea {
                        enabled: !root.is_scanning_versions;
                        clicked => { root.scan_versions_requested(); }
                    }
                    Text {
                        text: root.is_scanning_versions ? "正在扫描…" : "扫描版本";
                        color: #ffffff;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 138px;
                    height: 38px;
                    border-radius: 10px;
                    background: root.is_checking ? #94a3b8 : #0f766e;
                    TouchArea {
                        enabled: !root.is_checking;
                        clicked => { root.refresh_requested(); }
                    }
                    Text {
                        text: root.is_checking ? "正在检查…" : "刷新本机环境";
                        color: #ffffff;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        HorizontalLayout {
            height: 24px;
            spacing: 12px;
            Text { text: root.status_message; color: #64748b; font-size: 12px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "Shine Launcher · v" + root.app_version; color: #475569; font-size: 12px; vertical-alignment: center; }
        }
    }

    if root.show_about: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0f172a99;
        TouchArea { clicked => { } }
        Rectangle {
            x: (parent.width - 520px) / 2;
            y: (parent.height - 310px) / 2;
            width: 520px;
            height: 310px;
            border-radius: 18px;
            background: #ffffff;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: "关于 Shine Launcher"; color: #0f172a; font-size: 21px; font-weight: 700; }
                Text { text: "原生启动与管理中心 · 版本 " + root.app_version; color: #475569; font-size: 14px; }
                Text { text: "本技术验证版仅进行本机只读环境检查。"; color: #475569; font-size: 13px; }
                AboutSlint { }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: 9px;
                    background: #0f766e;
                    HorizontalLayout {
                        alignment: center;
                        Text { text: "关闭"; color: white; font-size: 14px; }
                    }
                    TouchArea { clicked => { root.close_about_requested(); } }
                }
            }
        }
    }
}
